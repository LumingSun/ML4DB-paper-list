# Credentials for local, high-accuracy audits (scripts/audit_scope.py).
#
#   cp config/audit.env.example ~/.config/ml4db/audit.env
#   chmod 600 ~/.config/ml4db/audit.env
#   # then fill in the values below
#
# The script reads ~/.config/ml4db/audit.env and ~/.config/ml4db/jev.env by
# default; existing environment variables always win.  Never commit a filled-in
# copy.

# --- required: DeepSeek (the deciding judge) --------------------------------
export LLM_API_KEY=
export LLM_BASE_URL=https://api.deepseek.com/v1
export LLM_MODEL=deepseek-chat

# --- optional: Jev, the independent second opinion --------------------------
# Without it the audit still runs (DeepSeek only) and says so in the report.
export JEV_API_KEY=
export JEV_URL=https://api.defapi.org/api/v1/decisions
export JEV_MODEL=typesafe/jev-1.14.0

# --- optional: OpenAlex key for title-search abstract lookup ----------------
# Anonymous OpenAlex is rate-limited to a shared daily budget; a free key
# (https://openalex.org/settings/api) makes fallback lookups reliable.
export OPENALEX_KEY=

# --- optional: corporate proxy, needed if the endpoints are unreachable -----
# export https_proxy=http://127.0.0.1:7890
# export http_proxy=http://127.0.0.1:7890
# export all_proxy=socks5://127.0.0.1:7890
